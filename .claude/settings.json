{
  "$schema": "https://json.schemastore.org/claude-code-settings.json",
  "model": "opus",
  "hooks": {
    "SessionStart": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "python tools/hooks/shadow_sync.py",
            "timeout": 30,
            "statusMessage": "Shadow auto-sync: casa espelho publicado com origin (ADR-070; no-op em master)"
          }
        ]
      },
      {
        "hooks": [
          {
            "type": "command",
            "command": "python tools/repo_mode.py",
            "timeout": 10,
            "statusMessage": "Modo por identidade: shadow=USER (aplica a dominio), master=DEV (ADR-070/072)"
          }
        ]
      },
      {
        "hooks": [
          {
            "type": "command",
            "command": "python tools/wire_gates.py --install-global --quiet",
            "timeout": 60,
            "statusMessage": "Ponto de Arquimedes (ADR-101): re-afirma skills + gates GLOBAIS a cada boot do framework"
          }
        ]
      },
      {
        "hooks": [
          {
            "type": "command",
            "command": "python tools/hooks/inject_start_session.py",
            "timeout": 15,
            "statusMessage": "Auto-boot do squad (ADR-006) — owner-allowlist ou marker; delete .claude/session.lock p/ desligar"
          }
        ]
      },
      {
        "hooks": [
          {
            "type": "command",
            "command": "python tools/hooks/check_repo_sync.py",
            "timeout": 30,
            "statusMessage": "Verificando sincronizacao do repo com origin (ADR-019/060/084)"
          }
        ]
      },
      {
        "hooks": [
          {
            "type": "command",
            "command": "python tools/hooks/check_core_agnostic_hook.py",
            "timeout": 20,
            "statusMessage": "Verificando agnosticismo do nucleo (ADR-020/061)"
          }
        ]
      },
      {
        "hooks": [
          {
            "type": "command",
            "command": "python tools/hooks/mission_gate.py",
            "timeout": 10,
            "statusMessage": "Verificando product_type/escopo (mission-gate ADR-022)"
          }
        ]
      },
      {
        "hooks": [
          {
            "type": "command",
            "command": "python tools/hooks/boot_brief.py",
            "timeout": 30,
            "statusMessage": "Briefing de boot (ADR-101): injeta o que JA esta decidido/documentado — anti-repergunta"
          }
        ]
      }
    ],
    "UserPromptSubmit": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "python tools/hooks/route_gate.py",
            "timeout": 10,
            "statusMessage": "Roteamento deterministico (route-gate ADR-027)"
          }
        ]
      },
      {
        "hooks": [
          {
            "type": "command",
            "command": "python tools/hooks/check_author_tier.py",
            "timeout": 10,
            "statusMessage": "Tier-autor: alerta se a sessao roda abaixo do baseline (ADR-082)"
          }
        ]
      }
    ],
    "PreToolUse": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "python tools/hooks/effect_gate.py",
            "timeout": 10,
            "statusMessage": "Gate de acoes destrutivas por efeito (effect-gate ADR-015)"
          }
        ],
        "matcher": "Bash|PowerShell"
      },
      {
        "hooks": [
          {
            "type": "command",
            "command": "python tools/hooks/prepush_sync_guard.py",
            "timeout": 20,
            "statusMessage": "Guard de pre-push: barra push sobre base atrasada (ADR-060)"
          }
        ],
        "matcher": "Bash|PowerShell"
      },
      {
        "hooks": [
          {
            "type": "command",
            "command": "python tools/hooks/shadow_write_guard.py",
            "timeout": 20,
            "statusMessage": "Shadow-write-guard: NEGA push de espelho publicado (ADR-070)"
          }
        ],
        "matcher": "Bash|PowerShell"
      },
      {
        "hooks": [
          {
            "type": "command",
            "command": "python tools/hooks/overwrite_guard.py",
            "timeout": 10,
            "statusMessage": "Anti-overwrite cego de artefato (overwrite-guard ADR-037)"
          }
        ],
        "matcher": "Write|Edit"
      },
      {
        "hooks": [
          {
            "type": "command",
            "command": "python tools/hooks/context_budget_gate.py",
            "timeout": 10,
            "statusMessage": "Context-budget: anuncia fracionar (doc-intake) em fonte grande (ADR-029)"
          }
        ],
        "matcher": "Read"
      }
    ],
    "PostToolUse": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "python tools/hooks/overwrite_guard.py",
            "timeout": 10,
            "statusMessage": "Registro de arquivos lidos/criados na sessao (overwrite-guard ADR-037)"
          }
        ],
        "matcher": "Read|Write|Edit|NotebookEdit"
      }
    ],
    "PreCompact": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "python tools/hooks/compaction_gate.py",
            "timeout": 10,
            "statusMessage": "Verificando digest antes de compactar (ADR-021)"
          }
        ]
      }
    ],
    "Stop": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "python tools/hooks/closing_gate.py",
            "timeout": 60,
            "statusMessage": "Encerramento deterministico (ADR-101): commit/PR, checkpoint, correlatos, memoria"
          }
        ]
      }
    ]
  }
}
